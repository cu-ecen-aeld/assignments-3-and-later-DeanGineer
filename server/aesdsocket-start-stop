#!/bin/sh

### BEGIN INIT INFO
# Provides:          aesdsocket
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start/stop aesdsocket daemon
# Description:       Controls the aesdsocket server as a daemon
### END INIT INFO

DAEMON_PATH="/usr/bin/aesdsocket"
DAEMON_OPTS="-d"
PID_FILE="/var/run/aesdsocket.pid"

case "$1" in
    start)
        echo "Starting aesdsocket..."
        start-stop-daemon --start --background --pidfile "$PID_FILE" --exec "$DAEMON_PATH" -- $DAEMON_OPTS
        if [ $? -eq 0 ]; then
            echo "aesdsocket started."
        else
            echo "Failed to start aesdsocket."
        fi
        ;;
    
    stop)
        echo "Stopping aesdsocket..."
        start-stop-daemon --stop --pidfile "$PID_FILE"
        if [ $? -eq 0 ]; then
            echo "aesdsocket stopped."
        else
            echo "Failed to stop aesdsocket."
        fi
        ;;
    
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    
    status)
        if [ -f "$PID_FILE" ]; then
            PID=$(cat "$PID_FILE")
            if kill -0 "$PID" 2>/dev/null; then
                echo "aesdsocket is running with PID $PID."
                exit 0
   
